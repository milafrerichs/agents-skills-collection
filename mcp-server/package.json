{
  "name": "skills-collection-mcp",
  "version": "1.0.0",
  "description": "MCP server for discovering and loading skills and agents from the collection",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
